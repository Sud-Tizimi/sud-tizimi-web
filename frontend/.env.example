# Faysal AI frontend env example
# Copy to .env.development for local dev. Vite reads .env.development automatically.

# Backend REST URL. Leave empty to use Vite proxy (/api -> http://localhost:8000)
VITE_API_URL=

# Backend WebSocket URL. Leave empty to use Vite proxy (/ws -> ws://localhost:8000)
VITE_WS_URL=

# Final ASR provider for /sessions Stop flow: local | openrouter | aistudio
VITE_ASR_PROVIDER=local
