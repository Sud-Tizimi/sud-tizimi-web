HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenRouter (post-processing of final chunks). Leave EMPTY for graceful degradation.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free
OPENROUTER_TIMEOUT_S=4.0

# STT provider: "mock" | "openrouter" | "future_local"
STT_PROVIDER=mock

# Demo script loop length in seconds (CP1 mock)
SCRIPT_LOOP_SEC=52

# ============================================================================
# Phase A — Accounts + MySQL
# ============================================================================

# MySQL via async driver. Create the database/user first:
#   CREATE DATABASE sudtizimi CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
#   CREATE USER 'sud'@'localhost' IDENTIFIED BY 'sud';
#   GRANT ALL PRIVILEGES ON sudtizimi.* TO 'sud'@'localhost';
DATABASE_URL=mysql+aiomysql://sud:sud@127.0.0.1:3306/sudtizimi?charset=utf8mb4

# JWT (HS256, 24h expiry)
JWT_SECRET=change-me-in-prod-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# File storage (Phase B uses this — defined now for stable config surface)
STORAGE_ROOT=uploads
MAX_UPLOAD_BYTES=26214400
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,jpg,jpeg,png
