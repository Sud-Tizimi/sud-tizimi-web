HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenRouter (post-processing of final chunks). Leave EMPTY for graceful degradation.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free
OPENROUTER_TIMEOUT_S=4.0

# Voice ASR cloud/local final transcription for /sessions.
# Provider: "local" | "openrouter" | "aistudio"
ASR_PROVIDER=local
ASR_OPENROUTER_MODEL=google/gemini-2.5-flash
ASR_AISTUDIO_MODEL=gemini-2.5-pro
ASR_TIMEOUT_S=600.0
LOCAL_ASR_BASE_URL=https://asr.bot-dev.uz
GEMINI_API_KEY=

# STT provider: "mock" | "openrouter" | "future_local"
STT_PROVIDER=mock

# Demo script loop length in seconds (CP1 mock)
SCRIPT_LOOP_SEC=52

# ============================================================================
# Phase A — Accounts + MySQL
# ============================================================================

# MySQL via async driver. Create the database/user first:
#   CREATE DATABASE sudtizimi CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
#   CREATE USER 'sud'@'localhost' IDENTIFIED BY 'sud';
#   GRANT ALL PRIVILEGES ON sudtizimi.* TO 'sud'@'localhost';
DATABASE_URL=mysql+aiomysql://sud:sud@127.0.0.1:3306/sudtizimi?charset=utf8mb4

# JWT (HS256, 24h expiry)
JWT_SECRET=change-me-in-prod-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# File storage (Phase B uses this — defined now for stable config surface)
STORAGE_ROOT=uploads
MAX_UPLOAD_BYTES=26214400
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,jpg,jpeg,png

# ============================================================================
# Phase 27 — SudAI-Law-UZ (legal document analysis)
# ============================================================================

# SudAI provider: "local" (regex + RAG, no LLM) | "future_remote" (CP3+)
SUDAI_PROVIDER=local

# Per-document AI analysis timeout
SUDAI_TIMEOUT_S=30.0

# Threshold for the "Awaiting staff review" vs "Human review required" recommendation
SUDAI_RECOMMENDATION_THRESHOLD=0.85

# Optional path to lexuz.db (SQLite RAG corpus). Leave empty to use the
# built-in LEGAL_KNOWLEDGE_BASE fallback (6 articles from FK / Oila / Mehnat / Soliq).
# When set, must point to a real file. Recommended: keep empty in CP1/CP2.
LEXUZ_DB_PATH=

# ============================================================================
# Phase D — OCR (UDIP engine ported: PaddleOCR / Tesseract / Gemini / Stub)
# ============================================================================

# OCR provider: "auto" | "gemini" | "paddle" | "tesseract" | "stub"
# "auto" → use Gemini if GEMINI_API_KEY is set, else Tesseract, else Stub.
OCR_PROVIDER=auto
OCR_LANG=uzb+rus+eng
OCR_MIN_CONFIDENCE=0.5
# Tesseract binary path (auto-detect on macOS / Linux / Win if empty)
TESSERACT_CMD=
# TESSDATA_PREFIX override for additional language packs (e.g. uzb.traineddata)
TESSDATA_DIR=
# Gemini OCR model (reuses GEMINI_API_KEY from above)
OCR_GEMINI_MODEL=gemini-2.5-pro
